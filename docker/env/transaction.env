# Local-stack transaction-service configuration. Committed on purpose: every
# value here is a local-only literal, and committing them is what makes
# `git clone && pnpm dev:services:local` work with no hand configuration.
#
# Read directly by compose's `env_file:`; there is no `${...}` templating here.
# Override any line locally in `docker/env/transaction.local.env`, which is
# gitignored and read after this file, so later wins.
#
# Adding a tenant is: a `TENANT_TOKEN_<n>` (plus any issuer instance) here, a
# seed and cryptosuite in `signing.env`, and one `TRANSACTION_SERVICE_TENANT_<n>_*`
# group in `.env`. `compose.dev.yml` names no tenant at all.
#
# Do NOT set `STATUS_SERVICE` here. Both compose files share this file, and the
# pinned stack runs no status service — the claim path allocates a status entry
# BEFORE signing, so a dangling `STATUS_SERVICE` fails every claim. It lives in
# `compose.local.yml`'s `environment:` instead.

PORT=4004

# Public URL the transaction service embeds in interaction URLs / QR codes.
# Override in `transaction.local.env` for cross-device wallet testing (LAN IP or
# an ngrok tunnel).
DEFAULT_EXCHANGE_HOST=http://localhost:4004

# Reached at the container DNS name, which is why mixed mode (compose
# transaction service + host signing service) is unsupported.
SIGNING_SERVICE=http://signing-service:4006

PERSIST_TO_FILE=/data/exchanges.kv

# OAuth2 access-JWT secret. Values say what they are, so a copy into a real
# deployment is self-evident.
ACCESS_JWT_SECRET=local-dev-only-not-a-secret-jwt-signing-key

# The default tenant. A tenant's token is deliberately written in two places:
# this file configures the CONTAINER, `.env` configures the APP
# (`TRANSACTION_SERVICE_TENANT_TOKEN`), and a deployed LITS has no containers at
# all. Keep the pair identical.
TENANT_TOKEN_DEFAULT=local-dev-only-not-a-secret-default

# The ECDSA tenant. Its sole issuer instance declares ECDSA, which is the ONLY
# way to force a cryptosuite: the transaction service picks its instance at CLAIM
# time by ranking the tenant's instances against the suites the WALLET
# advertised, so no request field can pin one. Pairs with
# `TRANSACTION_SERVICE_TENANT_2_TOKEN` in `.env`.
# `TENANT_ISSUER_<n>_ID_<T>` is the instance's issuer **DID**, not a nickname —
# `/health/ready` refuses anything that is not one, and the did:web publisher
# derives its document path from it. This is the DID the signing service derives
# from `TENANT_SEED_ECDSA` in `signing.env`; the seed is fixed and committed, so
# the DID is stable. Read it back at any time with:
#
#   curl -s -X POST http://localhost:4006/instance/ecdsa/credentials/sign \
#     -H 'Content-Type: application/json' \
#     -d '{"@context":["https://www.w3.org/ns/credentials/v2"],
#          "type":["VerifiableCredential"],"issuer":"did:example:placeholder",
#          "credentialSubject":{"id":"did:example:subject"}}' | jq -r .issuer
TENANT_TOKEN_ECDSA=local-dev-only-not-a-secret-ecdsa
TENANT_ISSUER_1_ID_ECDSA=did:key:zDnaeUYVT1oLejUPazNncTLzeH5XxfGJ6yiCArPs9Fsjz3hAb
TENANT_ISSUER_1_CRYPTOSUITE_ECDSA=ecdsa-rdfc-2019
TENANT_ISSUER_1_SIGNING_TENANT_ECDSA=ecdsa
