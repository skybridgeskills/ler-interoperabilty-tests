# Local-stack signing identities. Committed on purpose: these are never used on a
# deployed environment, and committing them is what makes `git clone &&
# pnpm dev:services:local` work with no hand configuration. dcc-signing-service
# ships a committed test seed for the same reason (src/config.js:13).
#
# A seed cannot describe itself the way a token can — do not paste one anywhere
# that matters.
#
# Read directly by compose's `env_file:`; there is no `${...}` templating here.
# Override any line locally in `docker/env/signing.local.env`, which is
# gitignored and read after this file, so later wins.

PORT=4006

# The default tenant.
#
# `TENANT_CRYPTOSUITE_DEFAULT` is NOT optional. `selectSuite`
# (dcc-signing-service/src/suites/selectSuite.js) falls through an unset value to
# `Ed25519Signature2020`, which is not a `DataIntegrityProof` — every
# `credential-di-proof-*` check would fail against the default tenant, silently.
TENANT_SEED_DEFAULT=z1Ajx3PwAcSigA6judiNX1MLf4DE3nVjrjdsjNAo6TPT2f1
TENANT_CRYPTOSUITE_DEFAULT=eddsa-rdfc-2022

# A SECOND tenant that signs ECDSA P-256, so a scenario can PIN a cryptosuite.
# `TENANT_CRYPTOSUITE_<T>` is the signing service's own knob — configuration, not
# a code change.
TENANT_SEED_ECDSA=z1AciSkDrBCBouE8x1AdK785dhuUdVxXxzj1SKGzct7GUub
TENANT_CRYPTOSUITE_ECDSA=ecdsa-rdfc-2019
