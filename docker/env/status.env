# Local-stack vcalm-status-service configuration, read only by
# `compose.local.yml` — the pinned stack runs no status service.
#
# Committed on purpose, exactly as the signing seeds are: every value is a
# local-only literal, and committing them is what makes `git clone &&
# pnpm dev:services:local` work with no hand configuration.
#
# Override any line locally in `docker/env/status.local.env`, which is
# gitignored and read after this file, so later wins.

PORT=4008

# The origin a WALLET or VERIFIER fetches a status list from. It is also the one
# host every tenant is authorized under without listing it (`domains.ts`), which
# is what makes the local fetch work. The transaction service reaches this
# service at the container DNS name instead, and that path is not host-checked —
# only the public GET of a list is.
PUBLIC_BASE_URL=http://localhost:4008

# `sqlite` with a volume, not `memory`: memory forgets every list when the
# process exits, which would break every credential already pointing at one.
# `local` signing keeps the key material below in-process, so the status service
# needs no tenant on the signing service.
STORAGE_MODE=sqlite
SIGNING_MODE=local
TENANT_REGISTRY_MODE=env

# Matches the volume mount in compose.local.yml.
SQLITE_FILE=/data/status-lists.db

# ------------------------------------------------------------------------------
# Tenant, minted once by the service's own CLI and pasted here verbatim:
#
#   pnpm provision-tenant --tenant lits_local --domains status.lits.test --print-only
#
# Run once, at implementation. A developer never runs it. The service has no
# provisioning endpoint and never will — provisioning is a write to whatever
# registry the service reads, and today that registry is env.
#
# The tenant id takes an underscore, not a hyphen: it becomes the suffix of
# `TENANT_TOKEN_<NAME>`, and the CLI refuses anything that would not.
# ------------------------------------------------------------------------------

# Tenant "lits_local" — profile did-key-eddsa-2022-v1 — did:key:z6Mkk32Xmm9EispsHk4pSQMYi9r54Hoos1K1bKtHQXEEo9xu
TENANT_TOKEN_LITS_LOCAL=wCD5juHzm1Ayj-G-9sdwE9OLT_ebjKhVMUk03tYIdMs
TENANT_DOMAINS_LITS_LOCAL=status.lits.test
TENANT_DEFAULT_INSTANCE_LITS_LOCAL=default
TENANT_ISSUER_1_ID_LITS_LOCAL=default
TENANT_ISSUER_1_CRYPTOSUITE_LITS_LOCAL=eddsa-rdfc-2022
TENANT_ISSUER_1_DID_METHOD_LITS_LOCAL=key
TENANT_ISSUER_1_SEED_LITS_LOCAL=z1AenqRLqZfZ5NbFCVF4AkRRDVWxvncQhPuociVh4Jbg1CP
