# LER Interoperability Test Suite — example environment

# CONTEXT controls which AppContext the server boots into:
#   dev    — pino-pretty logger, real time/id services
#   test   — silent logger, deterministic time/id services
#   hosted — plain JSON pino logger (for log aggregation), real time/id services
CONTEXT=dev

# pino log level (silent | error | warn | info | debug | trace)
# LOG_LEVEL=info

# Periodic health-snapshot logging (structured logs → Loki → Grafana).
# Disabled only when HEALTH_SNAPSHOT_ENABLED is exactly "false"; an interval
# <= 0 also disables it. Defaults shown.
# HEALTH_SNAPSHOT_ENABLED=true
# HEALTH_SNAPSHOT_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# Exchange runner — local DCC dependency services
# See docker/README.md for the full setup runbook.
# ------------------------------------------------------------------------------

# Toggle the in-app exchange runner. When false, the runnable wallet acceptance
# page renders a disabled-state hint instead of the live CTA.
EXCHANGE_RUNNER_ENABLED=false

# Where the suite's server endpoints reach the transaction service. Inside
# docker compose this stays http://localhost:4004 because compose maps the
# container port to the host.
#
# During an interop probe sitting this must reach the HOST transaction service,
# not the digest-pinned compose image — attach mode against the pinned image
# fails in ways that read like a wallet defect. See docker/README.md,
# "Attach mode and probe sittings".
TRANSACTION_SERVICE_URL=http://localhost:4004

# Tenant identity the suite presents to the transaction service.
#
# A tenant's token is deliberately written in TWO places: `docker/env/transaction.env`
# configures the CONTAINER, this file configures the APP, and a deployed LITS has
# no containers at all — so there is no one file that could hold both. Keep the
# pair identical. The value below matches the committed local-stack default.
TRANSACTION_SERVICE_TENANT_NAME=default
TRANSACTION_SERVICE_TENANT_TOKEN=local-dev-only-not-a-secret-default

# What this tenant ADVERTISES — not what a scenario requests.
#
# Cryptosuite and DID method are deployment configuration, not request
# variables: they are fixed by the signing service's TENANT_CRYPTOSUITE_<TENANT>
# and by whether TENANT_DID_URL_<TENANT> is set (did:web) or not (did:key). A
# scenario can only vary them by using a different tenant, and this suite holds
# one token — so these two say which pair that one tenant serves.
#
# `resolveIssuingContext` compares a scenario's pinned intent against these. A
# scenario asking for a pair this deployment does not serve renders disabled
# with a typed reason and still counts toward the completion denominator, so the
# badge is blocked rather than quietly made easier to earn.
#
# Keep them honest with the signing service's own config; defaults shown.
# TRANSACTION_SERVICE_TENANT_CRYPTOSUITE=eddsa-rdfc-2022
# TRANSACTION_SERVICE_TENANT_DID_METHOD=key

# ADDITIONAL tenants, so a scenario can PIN a cryptosuite.
#
# Pinning can only be a tenant swap. The transaction service chooses its issuer
# instance at *claim* time by ranking the tenant's instances against the
# cryptosuites the WALLET advertised, so nothing the suite sends when creating an
# exchange can request a suite. A tenant whose only issuer instance is ECDSA is
# what forces an ECDSA-signed credential.
#
# Configuring none of this is fine and fully supported: a single-tenant
# deployment runs every elective scenario, and every pinned scenario it cannot
# serve renders disabled with a typed reason while KEEPING its requirements in
# the completion denominator — so the badge is blocked rather than quietly made
# easier to earn. Two deployments must never issue badges that look identical and
# mean different things.
#
# Numbering starts at 2 (tenant 1 is the default above) and stops at the first
# missing _NAME. A tenant with no token is dropped rather than used, because
# minting on an empty Bearer token fails with an opaque `unauthorized`.
#
# The matching container config is committed in `docker/env/transaction.env`
# (the token and issuer instance) and `docker/env/signing.env` (the seed and
# `TENANT_CRYPTOSUITE_ECDSA`), so the local stack serves this tenant with no
# hand configuration. The token below is the committed container-side value —
# the same two-places pairing as the default tenant above.
TRANSACTION_SERVICE_TENANT_2_NAME=ecdsa
TRANSACTION_SERVICE_TENANT_2_TOKEN=local-dev-only-not-a-secret-ecdsa
TRANSACTION_SERVICE_TENANT_2_CRYPTOSUITE=ecdsa-rdfc-2019
TRANSACTION_SERVICE_TENANT_2_DID_METHOD=key

# Public origin the badge achievement.id / criteria.id resolve to — THIS app's
# own origin, where /badges/[slug] is served (not the transaction service). The
# ids embedded in a claimed badge credential must resolve to the badge page, so
# set this to the deployment's public origin. Defaults to the dev origin.
# BADGE_ROOT_URL=http://localhost:5173
#
# Issuing badges from did:web at the root domain is a DEPLOYMENT step, not app
# code — the badge recipe never names the issuer; the signing service stamps
# issuer.id from the tenant seed. To switch a tenant to did:web:
#   1. On the SIGNING service, set TENANT_DID_URL_<TENANT> and host its DID
#      document at the root domain. THIS repo serves no DID document.
#   2. Point TRANSACTION_SERVICE_TENANT_NAME / _TOKEN at that tenant and set
#      TRANSACTION_SERVICE_TENANT_DID_METHOD=web (and the matching _CRYPTOSUITE).
# Until then, badges issue from the tenant's did:key — correct for dev, and the
# app code is identical either way. Whether the pinned signing-service image
# honours TENANT_DID_URL is not verifiable from this repo.

# ------------------------------------------------------------------------------
# Container configuration lives in docker/env/, not here.
# ------------------------------------------------------------------------------
#
# `DEFAULT_EXCHANGE_HOST`, `ACCESS_JWT_SECRET`, `TENANT_TOKEN_*`, `TENANT_SEED_*`
# and the issuer-instance variables are read by the compose CONTAINERS, never by
# the SvelteKit app. They are committed local-only literals in
# `docker/env/transaction.env` and `docker/env/signing.env`, so a fresh clone
# needs no hand configuration and this file holds only what the app itself reads.
#
# To change one for yourself, write `docker/env/{transaction,signing}.local.env`
# — gitignored, read after the committed file, later wins. Cross-device wallet
# testing (a LAN IP or ngrok tunnel for `DEFAULT_EXCHANGE_HOST`) is the usual
# reason. See docker/README.md.
